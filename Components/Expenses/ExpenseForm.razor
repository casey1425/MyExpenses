@using MyExpenses.Data
@using MyExpenses.Services
@using Microsoft.JSInterop

<section class="panel entry-panel" aria-labelledby="entry-title">
    <div class="panel-heading">
        <div>
            <h2 id="entry-title">새 지출 추가</h2>
        </div>
    </div>

    <form @onsubmit="() => OnSubmit.InvokeAsync()" @onsubmit:preventDefault>
        <div class="field-grid">
            <div class="field">
                <label for="expense-date">날짜</label>
                <input id="expense-date" type="date" @bind="Date" @bind:after="() => DateChanged.InvokeAsync(Date)" required />
            </div>
            <div class="field">
                <label for="expense-amount">금액</label>
                <div class="amount-input">
                    <input id="expense-amount" type="number" inputmode="numeric" min="1" step="1" placeholder="0" @ref="amountInput" @bind="Amount" @bind:after="() => AmountChanged.InvokeAsync(Amount)" required />
                    <span>원</span>
                </div>
            </div>
        </div>

        <div class="field">
            <label for="expense-category">카테고리</label>
            <select id="expense-category" @bind="Category" @bind:after="() => CategoryChanged.InvokeAsync(Category)">
                @foreach (var option in Categories)
                {
                    <option value="@option">@CategoryLabel(option)</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="expense-memo">메모 <span class="optional">선택</span></label>
            <input id="expense-memo" type="text" maxlength="100" placeholder="예: 점심 식사" list="memo-suggestions" autocomplete="off" @bind="Memo" @bind:after="() => MemoChanged.InvokeAsync(Memo)" />
            <datalist id="memo-suggestions">
                @foreach (var suggestion in Suggestions)
                {
                    <option value="@suggestion.Memo">@suggestion.Category · @suggestion.Amount.ToString("N0")원</option>
                }
            </datalist>
            @if (!string.IsNullOrEmpty(AutofillNotice))
            {
                <p class="autofill-notice" role="status">@AutofillNotice</p>
            }
        </div>
        <div class="field">
            <label for="expense-payment">결제수단 <span class="optional">선택</span></label>
            <select id="expense-payment" @bind="PaymentMethodId" @bind:after="() => PaymentMethodIdChanged.InvokeAsync(PaymentMethodId)">
                <option value="">미지정</option>
                @foreach (var method in PaymentMethods) { <option value="@method.Id">@method.Name (@method.Type)</option> }
            </select>
            @if (PaymentError is not null) { <p class="form-error" role="alert">@PaymentError</p> }
        </div>

        <details class="more-fields" open="@MoreOpen">
            <summary>태그 · 템플릿 · 결제수단 관리@(MoreOpen ? "" : " (선택)")</summary>
            <div class="template-picker">
                <div class="field">
                    <label for="expense-template">즐겨찾기 템플릿</label>
                    <select id="expense-template" value="@SelectedTemplateId" @onchange="OnTemplateSelected" disabled="@TemplateBusy">
                        <option value="">템플릿 선택 (선택 사항)</option>
                        @foreach (var template in Templates)
                        {
                            <option value="@template.Id">@template.Name · @template.Amount.ToString("N0")원</option>
                        }
                    </select>
                </div>
                <div class="template-picker-actions">
                    <a href="/templates">템플릿 관리</a>
                    <button type="button" class="filter-reset" disabled="@TemplateBusy" @onclick="() => OnRefreshTemplates.InvokeAsync()">목록 새로고침</button>
                </div>
                <p class="template-help">금액·카테고리·메모를 채웁니다. 날짜는 유지되며 기록 버튼을 눌러야 저장됩니다.</p>
                @if (TemplateError is not null) { <p class="form-error" role="alert">@TemplateError</p> }
                @if (TemplateNotice is not null) { <p class="save-notice" role="status">@TemplateNotice</p> }
            </div>
            <div class="field">
                <label for="expense-tags">태그 <span class="optional">선택 · 쉼표로 구분, 최대 @(TagNames.MaxPerExpense)개</span></label>
                <input id="expense-tags" type="text" placeholder="예: 여행, 경조사" autocomplete="off" @bind="TagsText" @bind:after="() => TagsTextChanged.InvokeAsync(TagsText)" />
                @if (TagChoices.Count > 0)
                {
                    <div class="tag-choices" role="group" aria-label="자주 쓰는 태그">
                        @foreach (var choice in TagChoices)
                        {
                            <button type="button" class="tag-choice @(IsSelected(choice.Name) ? "selected" : "")" aria-pressed="@(IsSelected(choice.Name) ? "true" : "false")"
                                    @onclick="() => OnToggleTag.InvokeAsync(choice.Name)">#@choice.Name</button>
                        }
                    </div>
                }
            </div>
            <div class="template-picker-actions payment-tools">
                <span>결제수단</span>
                <a href="/payment-methods">관리·월별 합계</a>
                <button type="button" class="filter-reset" @onclick="() => OnRefreshPaymentMethods.InvokeAsync()" disabled="@PaymentBusy">목록 새로고침</button>
            </div>
        </details>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="form-error" role="alert">@ErrorMessage</p>
        }

        @if (!string.IsNullOrEmpty(SaveNotice))
        {
            <p class="save-notice" role="status">@SaveNotice</p>
        }

        <button class="add-button" type="submit" disabled="@TemplateBusy">+ 지출 기록하기</button>
    </form>
</section>

@code {
    private ElementReference amountInput;

    // 태그·템플릿은 평소에는 접어 두고, 값이 있거나 오류·안내가 있을 때만 펼칩니다.
    private bool MoreOpen => !string.IsNullOrWhiteSpace(TagsText) || !string.IsNullOrEmpty(SelectedTemplateId)
        || TemplateError is not null || TemplateNotice is not null;

    // 지출을 기록한 뒤 바로 다음 금액을 입력할 수 있게 금액 칸으로 포커스를 옮깁니다.
    public async Task FocusAmountAsync()
    {
        try { await amountInput.FocusAsync(); }
        catch (InvalidOperationException) { /* 아직 화면에 연결되지 않았으면 건너뜁니다. */ }
        catch (JSException) { }
    }

    [Parameter] public string TagsText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TagsTextChanged { get; set; }
    [Parameter] public IReadOnlyList<TagUsage> TagChoices { get; set; } = [];
    [Parameter] public EventCallback<string> OnToggleTag { get; set; }

    private bool IsSelected(string name)
    {
        var key = TagNames.Key(name);
        return TagsText.Split([',', '，'], StringSplitOptions.RemoveEmptyEntries).Select(item => TagNames.Clean(item)).Any(item => item is not null && TagNames.Key(item) == key);
    }

    [Parameter] public IReadOnlyList<MemoSuggestion> Suggestions { get; set; } = [];
    [Parameter] public string? AutofillNotice { get; set; }

    [Parameter] public List<ExpenseTemplate> Templates { get; set; } = [];
    [Parameter] public string SelectedTemplateId { get; set; } = string.Empty;
    [Parameter] public bool TemplateBusy { get; set; }
    [Parameter] public string? TemplateError { get; set; }
    [Parameter] public string? TemplateNotice { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnTemplateSelected { get; set; }
    [Parameter] public EventCallback OnRefreshTemplates { get; set; }

    [Parameter] public DateTime Date { get; set; }
    [Parameter] public EventCallback<DateTime> DateChanged { get; set; }
    [Parameter] public long Amount { get; set; }
    [Parameter] public EventCallback<long> AmountChanged { get; set; }
    [Parameter] public string Category { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CategoryChanged { get; set; }
    [Parameter] public string Memo { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> MemoChanged { get; set; }
    [Parameter] public int? PaymentMethodId { get; set; }
    [Parameter] public EventCallback<int?> PaymentMethodIdChanged { get; set; }

    [Parameter] public IReadOnlyList<string> Categories { get; set; } = [];
    [Parameter] public Func<string, string> CategoryLabel { get; set; } = value => value;
    [Parameter] public List<PaymentMethod> PaymentMethods { get; set; } = [];
    [Parameter] public bool PaymentBusy { get; set; }
    [Parameter] public string? PaymentError { get; set; }
    [Parameter] public EventCallback OnRefreshPaymentMethods { get; set; }

    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SaveNotice { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
}
