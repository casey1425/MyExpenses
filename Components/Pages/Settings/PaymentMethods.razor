@page "/payment-methods"
@namespace MyExpenses.Components.Pages
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using MyExpenses.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PaymentMethodService MethodService
@inject ILogger<PaymentMethods> Logger

<PageTitle>결제수단 | MyExpenses</PageTitle>
<main class="methods-page">
    <PageHeader Title="결제수단별 지출 관리" Description="현금·카드·계좌이체를 구분해 기록합니다. 금융기관과 연결하지 않으며 카드번호나 계좌번호는 입력하지 마세요." />
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    <section class="method-card" aria-labelledby="method-form-title">
        <h2 id="method-form-title">@(editingId is null ? "결제수단 등록" : "결제수단 수정")</h2>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <div class="method-fields">
                    <label>이름 <input type="text" maxlength="50" placeholder="예: 국민 체크카드" @bind="name" required /></label>
                    <label>유형
                        <select @bind="type">
                            @foreach (var option in PaymentMethod.Types) { <option value="@option">@option</option> }
                        </select>
                    </label>
                </div>
                <div class="actions">
                    <button type="submit">@(busy ? "처리 중..." : editingId is null ? "등록" : "변경 저장")</button>
                    @if (editingId is not null) { <button type="button" class="secondary" @onclick="CancelEdit">취소</button> }
                </div>
            </fieldset>
        </form>
    </section>
    <section class="method-card" aria-labelledby="method-totals-title">
        <h2 id="method-totals-title">내 결제수단과 월별 합계</h2>
        <div class="month-selector">
            <label for="method-month">조회 월</label>
            <input id="method-month" type="month" value="@monthInput" @onchange="MonthChangedAsync" disabled="@busy" />
            <button type="button" class="secondary" @onclick="RefreshAsync" disabled="@busy">새로고침</button>
        </div>
        <p class="help">선택한 달 전체의 지출입니다. 지출 화면의 검색 조건과 무관하며, 기존 기록·CSV 4열 파일·정기 지출은 기본적으로 미지정입니다.</p>
        @if (loading) { <LoadingState /> }
        else
        {
            <p class="total" role="status">@month.ToString("yyyy년 M월") · 합계 @totals.Sum(t => t.Amount).ToString("N0")원 · @totals.Sum(t => t.Count)건</p>
            @if (methods.Count == 0) { <EmptyState Compact="true" Icon="💳" Title="아직 결제수단이 없어요" Description="위에서 자주 쓰는 결제수단을 등록하면 지출마다 고를 수 있어요." /> }
            @foreach (var total in totals)
            {
                <article class="method-item">
                    <div class="method-summary">
                        <div>
                            <h3>@total.Name @(total.Type == "" ? "" : $"({total.Type})")</h3>
                            <p>@total.Amount.ToString("N0")원 · @total.Count 건</p>
                        </div>
                        @if (total.Id is int id)
                        {
                            var method = methods.Single(m => m.Id == id);
                            <div class="actions">
                                <button type="button" class="secondary" @onclick="() => Edit(method)" disabled="@busy">수정</button>
                                <button type="button" class="danger" @onclick="() => deletingId = id" disabled="@busy">삭제</button>
                            </div>
                        }
                    </div>
                    @if (total.Id.HasValue && deletingId == total.Id)
                    {
                        <div class="delete-confirm" role="alert">
                            <p>이 결제수단을 삭제할까요? 지출과 템플릿은 삭제되지 않고 결제수단만 미지정으로 변경됩니다.</p>
                            <div class="actions">
                                <button type="button" class="danger" @onclick="() => DeleteAsync(total.Id.Value)" disabled="@busy">결제수단 삭제</button>
                                <button type="button" class="secondary" @onclick="() => deletingId = null" disabled="@busy">취소</button>
                            </div>
                        </div>
                    }
                </article>
            }
        }
    </section>
</main>
