@page "/account"
@namespace MyExpenses.Components.Pages
@attribute [Authorize]
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>계정 관리 | MyExpenses</PageTitle>

<main class="account-management-page">
    <PageHeader Title="계정 관리" Description="로그인 계정과 저장된 데이터를 관리합니다." />

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="account-management-error" role="alert">@Error</p>
    }

    <section class="account-management-card">
        <h2>로그인 계정</h2>
        <dl class="account-details">
            <dt>Google 계정</dt>
            <dd>@(email ?? "확인할 수 없음")</dd>
        </dl>
        <a class="account-export-link" href="/export/expenses.csv?scope=all">전체 지출 CSV 백업</a>
        <a class="account-export-link" href="/export/income.csv">전체 수입 CSV 백업</a>
        <a class="account-export-link" href="/backup">전체 데이터 백업·복원</a>
    </section>

    <section class="account-management-card" aria-labelledby="display-title">
        <h2 id="display-title">화면 설정</h2>
        <div class="setting-row">
            <span id="theme-label">화면 모드</span>
            <div class="segmented" role="group" aria-labelledby="theme-label">
                <button type="button" data-theme-choice="system" aria-pressed="false">시스템</button>
                <button type="button" data-theme-choice="light" aria-pressed="false">밝게</button>
                <button type="button" data-theme-choice="dark" aria-pressed="false">어둡게</button>
            </div>
        </div>
        <div class="setting-row">
            <span id="font-label">글자 크기</span>
            <div class="segmented" role="group" aria-labelledby="font-label">
                <button type="button" data-font-choice="normal" aria-pressed="true">보통</button>
                <button type="button" data-font-choice="large" aria-pressed="false">크게</button>
            </div>
        </div>
        <p class="setting-note">이 기기의 브라우저에만 저장됩니다.</p>
    </section>

    <section class="account-management-card danger-zone" aria-labelledby="delete-account-title">
        <p class="danger-kicker">DANGER ZONE</p>
        <h2 id="delete-account-title">계정과 데이터 삭제</h2>
        <p>
            지출 기록, 전체·카테고리별 월 예산, 정기 지출 규칙, 즐겨찾기 템플릿, 결제수단, 사용자 카테고리, 프로필, Google 로그인 연결 정보가 모두 삭제됩니다.
            삭제한 내용은 복구할 수 없으므로 필요하면 먼저 전체 데이터를 백업하세요.
            Google 계정 자체는 삭제되지 않습니다.
        </p>

        <form method="post" action="/account/delete" class="delete-account-form">
            <AntiforgeryToken />
            <label for="delete-confirmation">확인을 위해 <strong>계정 삭제</strong>를 입력하세요.</label>
            <input id="delete-confirmation" name="confirmation" type="text" required
                   pattern="계정 삭제" autocomplete="off" placeholder="계정 삭제" />
            <label class="delete-understood">
                <input name="understood" type="checkbox" value="true" required />
                모든 데이터가 영구적으로 삭제되며 되돌릴 수 없음을 이해했습니다.
            </label>
            <button type="submit" class="delete-account-button">계정과 모든 데이터 삭제</button>
        </form>
    </section>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? email;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        email = authenticationState.User.FindFirstValue(ClaimTypes.Email)
            ?? authenticationState.User.Identity?.Name;
    }
}
