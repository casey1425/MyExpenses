@page "/backup"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using MyExpenses.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BackupService BackupService
@inject ILogger<Backup> Logger

<PageTitle>백업·복원 | MyExpenses</PageTitle>

<main class="import-page">
    <header class="import-heading">
        <p class="import-kicker">BACKUP &amp; RESTORE</p>
        <h1>백업·복원</h1>
        <p>내 모든 가계부 데이터를 파일 하나로 내려받고, 같은 파일로 다시 복원합니다. 다른 Google 계정으로 옮길 때도 쓸 수 있어요.</p>
    </header>

    <section class="import-card" aria-labelledby="backup-title">
        <h2 id="backup-title">전체 백업</h2>
        <p>지출, 수입, 카테고리, 결제수단, 즐겨찾기 템플릿, 월·카테고리 예산, 정기 지출·수입(자동 생성 이력 포함), 목표 저축과 저축 내역을 JSON 파일 하나로 저장합니다.</p>
        <a class="backup-download" href="/export/backup.json" download>내 데이터 전체 백업 내려받기</a>
        <p class="format-hint">백업 파일에는 가계부 정보가 모두 담겨 있으니 안전한 곳에 보관하고, 다른 사람과 공유하지 마세요. 로그인 정보와 이메일은 포함되지 않습니다.</p>
    </section>

    <section class="import-card" aria-labelledby="restore-title">
        <h2 id="restore-title">백업에서 복원</h2>
        <p>MyExpenses에서 내려받은 백업 파일(.json, 최대 @(BackupLimits.MaxFileBytes / 1024 / 1024)MB)을 선택하세요. 선택해도 바로 저장되지는 않으며, 내용을 확인한 뒤 복원 버튼을 눌러야 합니다.</p>
        <InputFile @key="fileInputVersion" OnChange="ReadFileAsync" accept=".json,application/json"
                   disabled="@busy" aria-label="백업 파일 선택" />
    </section>

    @if (busy)
    {
        <p class="import-status" role="status">처리하고 있습니다...</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="import-error" role="alert">@errorMessage</p>
    }

    @if (issues.Count > 0)
    {
        <div class="import-issues" role="alert">
            <strong>이 파일은 복원할 수 없습니다. 파일을 확인한 뒤 다시 선택해 주세요.</strong>
            <ul>
                @foreach (var issue in issues)
                {
                    <li>@issue</li>
                }
            </ul>
        </div>
    }

    @if (result is not null)
    {
        <div class="import-success" role="status">
            <p>@(result.Mode == BackupRestoreMode.Replace ? "덮어쓰기" : "병합") 복원을 마쳤습니다. @result.TotalAdded.ToString("N0")건을 추가했고 @result.TotalSkipped.ToString("N0")건은 이미 있어 건너뛰었습니다.@(result.Mode == BackupRestoreMode.Replace ? $" 기존 데이터 {result.DeletedRows:N0}건은 삭제했습니다." : "")</p>
            @foreach (var warning in result.Warnings)
            {
                <p>※ @warning</p>
            }
            <a href="/">지출 기록 보기</a>
        </div>
    }

    @if (backup is not null && preview is not null)
    {
        <section class="import-card" aria-labelledby="preview-title">
            <h2 id="preview-title">복원 미리보기</h2>
            <p class="backup-meta">@fileName · @backup.ExportedAt.ToString("yyyy-MM-dd HH:mm")에 만든 백업 · 총 @backup.Counts.Total.ToString("N0")개 항목</p>

            <fieldset class="mode-options" disabled="@busy">
                <legend>복원 방식</legend>
                <label class="mode-option">
                    <input type="radio" name="restore-mode" checked="@(mode == BackupRestoreMode.Merge)" @onchange="() => ChangeModeAsync(BackupRestoreMode.Merge)" />
                    <span><strong>병합 (권장)</strong><small>백업에만 있는 항목을 추가합니다. 이미 있는 항목은 건너뛰고 현재 데이터는 바꾸지 않아요. 같은 파일을 다시 복원해도 늘어나지 않습니다.</small></span>
                </label>
                <label class="mode-option">
                    <input type="radio" name="restore-mode" checked="@(mode == BackupRestoreMode.Replace)" @onchange="() => ChangeModeAsync(BackupRestoreMode.Replace)" />
                    <span><strong>덮어쓰기</strong><small>현재 데이터를 모두 지우고 백업 내용으로 바꿉니다. 백업 이후에 기록한 내용은 사라집니다.</small></span>
                </label>
            </fieldset>

            <div class="import-table-wrap">
                <table class="report-table">
                    <thead><tr><th>항목</th><th>백업 안</th><th>@(mode == BackupRestoreMode.Replace ? "복원됨" : "추가됨")</th><th>이미 있음</th></tr></thead>
                    <tbody>
                        @foreach (var row in preview.Sections)
                        {
                            <tr>
                                <td>@row.Name</td>
                                <td>@row.Total.ToString("N0")</td>
                                <td>@row.Added.ToString("N0")</td>
                                <td>@row.Skipped.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (preview.Warnings.Count > 0)
            {
                <ul class="warning-list" role="status">
                    @foreach (var warning in preview.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            @if (mode == BackupRestoreMode.Replace)
            {
                <div class="replace-warning" role="alert">
                    <strong>현재 데이터 @preview.DeletedRows.ToString("N0")건이 삭제됩니다.</strong>
                    되돌릴 수 없으니 먼저 <a href="/export/backup.json" download>현재 데이터를 백업</a>해 두세요.
                    계속하려면 아래에 <strong>@ReplacePhrase</strong>를 입력해 주세요.
                    <input type="text" @bind="confirmText" @bind:event="oninput" autocomplete="off" aria-label="확인 문구 입력" placeholder="@ReplacePhrase" />
                </div>
            }

            <div class="import-actions">
                <button type="button" @onclick="ApplyAsync" disabled="@(busy || !CanApply)">
                    @(busy ? "복원 중..." : mode == BackupRestoreMode.Replace ? "덮어쓰기 복원" : $"{preview.TotalAdded:N0}건 병합 복원")
                </button>
            </div>
        </section>
    }
</main>
