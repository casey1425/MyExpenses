@page "/account/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager

<PageTitle>로그인 | MyExpenses</PageTitle>

<div class="account-page">
    <section class="account-card" aria-labelledby="login-title">
        <p class="account-kicker">MY EXPENSES</p>
        <h1 id="login-title">로그인</h1>
        <p class="account-description">내 지출 기록을 확인하려면 로그인하세요.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="account-error" role="alert">@Error</p>
        }

        <form method="post" action="/account/login" class="account-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
            <label for="login-email">이메일</label>
            <input id="login-email" name="Email" type="email" autocomplete="username" required autofocus />

            <label for="login-password">비밀번호</label>
            <input id="login-password" name="Password" type="password" autocomplete="current-password" required />

            <label class="remember-row">
                <input name="RememberMe" type="checkbox" value="true" />
                로그인 상태 유지
            </label>

            <button type="submit">로그인</button>
        </form>

        @if (!hasAccount)
        {
            <p class="account-link">처음 실행하셨나요? <a href="/account/register">관리자 계정 만들기</a></p>
        }
    </section>
</div>

@code {
    private bool hasAccount = true;

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string SafeReturnUrl =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') &&
        !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";

    protected override async Task OnInitializedAsync()
    {
        hasAccount = await UserManager.Users.AnyAsync();
    }
}
