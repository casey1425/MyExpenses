@page "/account/login"
@attribute [AllowAnonymous]
@inject IConfiguration Configuration

<PageTitle>로그인 | MyExpenses</PageTitle>

<div class="account-page">
    <section class="account-card" aria-labelledby="login-title">
        <p class="account-kicker">MY EXPENSES</p>
        <h1 id="login-title">로그인</h1>
        <p class="account-description">허용된 Google 계정으로 내 지출 기록에 로그인하세요.</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="account-error" role="alert">@Error</p>
        }

        @if (GoogleIsConfigured)
        {
            <a class="google-login-button" href="@GoogleLoginUrl">
                <span aria-hidden="true">G</span>
                Google 계정으로 로그인
            </a>
        }
        else
        {
            <p class="account-setup">Google OAuth 설정이 아직 완료되지 않았습니다. README의 설정 방법에 따라 Client ID, Client Secret, 허용할 Gmail 주소를 등록해 주세요.</p>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string SafeReturnUrl =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') &&
        !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";

    private bool GoogleIsConfigured =>
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:AllowedEmail"]);

    private string GoogleLoginUrl =>
        $"/account/google-login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
}
