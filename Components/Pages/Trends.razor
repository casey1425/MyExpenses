@page "/trends"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using MyExpenses.Data
@using MyExpenses.Components.Charts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ExpenseTrendsService TrendsService
@inject RecurringExpenseService RecurringExpenseService
@inject RecurringIncomeService RecurringIncomeService
@inject ILogger<Trends> Logger

<PageTitle>월별 수입·지출 추이 | MyExpenses</PageTitle>

<main class="trends-page">
    <header class="trends-heading">
        <p class="kicker">SPENDING TRENDS</p>
        <h1>월별 수입·지출 추이</h1>
        <p>월별 수입·지출 흐름과 전월 대비 변화를 확인해 보세요.</p>
    </header>

    <div class="month-controls">
        <label for="trend-month">조회할 월</label>
        <input id="trend-month" type="month" value="@monthInput" @onchange="OnMonthChangedAsync"
               min="0001-06" max="@today.ToString("yyyy-MM", CultureInfo.InvariantCulture)" disabled="@isLoading" />
        <button type="button" @onclick="ReloadAsync" disabled="@isLoading">새로고침</button>
    </div>

    @if (isLoading)
    {
        <p class="loading" role="status">지출 추이를 불러오고 있습니다...</p>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="error" role="alert">@errorMessage</p>
    }

    @if (report is not null && !isLoading)
    {
        <section class="trend-panel" aria-labelledby="comparison-title">
            <h2 id="comparison-title">전월 비교</h2>
            <p class="period-note">@Period(report.Month, report.CurrentEnd)와 @Period(report.PreviousMonth, report.PreviousEnd)를 비교합니다.</p>
            @if (report.IsCurrentMonth)
            {
                <p class="comparison-help">이번 달은 오늘까지, 전월은 같은 날짜까지 비교합니다. 전월에 같은 날짜가 없으면 말일까지 포함합니다. 날짜는 한국 시간 기준입니다.</p>
            }
            <div class="comparison-cards">
                <div class="comparison-card">
                    <span>@report.Month.ToString("yyyy년 M월")</span>
                    <strong>@report.Comparison.CurrentAmount.ToString("N0")<small>원</small></strong>
                    <span>@(report.Comparison.CurrentCount)건 · @(report.IsCurrentMonth ? "오늘까지" : "한 달 전체")</span>
                </div>
                <div class="comparison-card">
                    <span>@report.PreviousMonth.ToString("yyyy년 M월")</span>
                    <strong>@report.Comparison.PreviousAmount.ToString("N0")<small>원</small></strong>
                    <span>@(report.Comparison.PreviousCount)건 · @(report.IsCurrentMonth ? $"{report.PreviousEnd.Day}일까지" : "한 달 전체")</span>
                </div>
                <div class="comparison-card change-card @ChangeClass(report.Comparison)">
                    <span>전월 대비</span>
                    <strong class="difference">@DifferenceText(report.Comparison)</strong>
                    <span>@RateText(report.Comparison)</span>
                </div>
            </div>
            <p class="comparison-help">저장된 지출 기록을 기준으로 계산합니다. 기록이 없는 기간은 0원으로 표시합니다.</p>
        </section>

        <section class="trend-panel" aria-labelledby="chart-title">
            <h2 id="chart-title">6개월 지출 추이</h2>
            <p class="period-note">@report.Months[0].Month.ToString("yyyy년 M월") ~ @report.Month.ToString("yyyy년 M월") · @(report.IsCurrentMonth ? "이번 달은 오늘까지의 합계" : "각 월 전체 합계")</p>
            <ExpenseTrendChart Months="report.Months" />
        </section>

        @if (report.CashflowMonths is { Count: > 0 } cashflow)
        {
            var selected = cashflow[^1];
            <section class="trend-panel" aria-labelledby="cashflow-title">
                <h2 id="cashflow-title">수입·지출·순수지</h2>
                <p class="period-note">@Period(report.Month, report.CurrentEnd)의 수입과 지출을 비교합니다. 순수지는 수입에서 지출을 뺀 금액이고, 저축률은 순수지를 수입으로 나눈 값입니다.</p>
                <div class="cashflow-cards">
                    <div class="comparison-card">
                        <span>수입 · @(selected.IncomeCount)건</span>
                        <strong class="income-text">@selected.Income.ToString("N0")<small>원</small></strong>
                    </div>
                    <div class="comparison-card">
                        <span>지출</span>
                        <strong>@selected.Expense.ToString("N0")<small>원</small></strong>
                    </div>
                    <div class="comparison-card @(selected.Net < 0 ? "increase" : "decrease")">
                        <span>순수지</span>
                        <strong>@(selected.Net < 0 ? "-" : "")@Math.Abs(selected.Net).ToString("N0")<small>원</small></strong>
                    </div>
                    <div class="comparison-card">
                        <span>저축률</span>
                        <strong>@(selected.SavingsRate is double rate ? $"{rate.ToString("0.#", CultureInfo.InvariantCulture)}%" : "-")</strong>
                    </div>
                </div>
                <h3 class="cashflow-chart-title">6개월 수입·지출 추이</h3>
                <CashflowChart Months="cashflow" />
                <p class="comparison-help">수입은 <a href="/income">수입 기록</a>에서 등록합니다. 수입이 없는 달은 저축률을 표시하지 않습니다.</p>
            </section>
        }

        <section class="trend-panel" aria-labelledby="category-comparison-title">
            <h2 id="category-comparison-title">카테고리별 전월 비교</h2>
            <p class="period-note">위의 전월 비교와 같은 기간을 사용합니다.</p>
            <div class="comparison-table-wrap">
                <table class="comparison-table">
                    <caption class="visually-hidden">카테고리별 지출 금액과 전월 대비 변화</caption>
                    <thead>
                        <tr><th scope="col">카테고리</th><th scope="col">@report.PreviousMonth.ToString("yyyy.MM")</th><th scope="col">@report.Month.ToString("yyyy.MM")</th><th scope="col">금액 차이</th><th scope="col">증감률</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var category in report.Categories)
                        {
                            <tr>
                                <th scope="row">@category.Category</th>
                                <td>@category.Comparison.PreviousAmount.ToString("N0")원</td>
                                <td>@category.Comparison.CurrentAmount.ToString("N0")원</td>
                                <td class="@ChangeClass(category.Comparison)">@DifferenceText(category.Comparison)</td>
                                <td class="@ChangeClass(category.Comparison)">@RateText(category.Comparison)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    <a href="/">← 지출 기록으로 돌아가기</a>
</main>
