@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using MyExpenses.Data
@inject IDbContextFactory<ExpensesDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserDataProvisioner UserDataProvisioner
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>지출 기록 | MyExpenses</PageTitle>

<div class="expense-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">MY EXPENSES</p>
            <h1>지출 기록</h1>
            <p class="subtitle">오늘의 지출을 간편하게 기록하고 확인해 보세요.</p>
        </div>
        <div class="today-chip">@DateTime.Today.ToString("yyyy년 M월 d일")</div>
    </header>

    <section class="summary-grid" aria-label="지출 요약">
        <div class="summary-card primary-summary">
            <span class="summary-label">@(activeFilter.IsActive ? "필터 결과 합계" : "이번 달 지출")</span>
            <strong>@((activeFilter.IsActive ? FilteredTotal : MonthlyTotal).ToString("N0"))<small>원</small></strong>
            <span class="summary-note">@(activeFilter.IsActive ? FilterDescription : $"{DateTime.Today:yyyy년 M월} 기준")</span>
        </div>
        <div class="summary-card">
            <span class="summary-label">@(activeFilter.IsActive ? "조회된 지출" : "기록한 지출")</span>
            <strong>@expenses.Count<small>건</small></strong>
            <span class="summary-note">@(activeFilter.IsActive ? FilterDescription : "전체 기록")</span>
        </div>
    </section>

    <section class="panel budget-panel" aria-labelledby="budget-title">
        <div class="panel-heading budget-heading">
            <div>
                <p class="section-kicker">MONTHLY BUDGET</p>
                <h2 id="budget-title">월별 예산</h2>
                <p class="budget-description">선택한 달의 전체 지출과 예산을 비교합니다.</p>
            </div>
        </div>

        <form class="budget-form" @onsubmit="SaveBudgetAsync" @onsubmit:preventDefault>
            <div class="budget-field">
                <label for="budget-month">월</label>
                <input id="budget-month" type="month" value="@budgetMonthInput" @onchange="OnBudgetMonthChangedAsync" required />
            </div>
            <div class="budget-field">
                <label for="budget-amount">예산 금액</label>
                <div class="amount-input">
                    <input id="budget-amount" type="number" min="1" step="1" @bind="budgetInput" required />
                    <span>원</span>
                </div>
            </div>
            <div class="budget-buttons">
                <button type="submit" class="budget-save" disabled="@isSavingBudget">@(isSavingBudget ? "저장 중..." : budgetAmount is null ? "예산 설정" : "예산 변경")</button>
                @if (budgetAmount is not null)
                {
                    <button type="button" class="budget-delete" @onclick="DeleteBudgetAsync" disabled="@isSavingBudget">예산 삭제</button>
                }
            </div>
        </form>

        @if (!string.IsNullOrEmpty(budgetError))
        {
            <p class="form-error" role="alert">@budgetError</p>
        }
        @if (!string.IsNullOrEmpty(budgetNotice))
        {
            <p class="budget-notice" role="status">@budgetNotice</p>
        }

        @if (budgetAmount is long limit)
        {
            <div class="budget-progress">
                <div class="budget-progress-labels">
                    <strong>@budgetSpent.ToString("N0")원 사용</strong>
                    <span>예산 @limit.ToString("N0")원 · @BudgetPercentage.ToString("0.#")%</span>
                </div>
                <div class="budget-track" role="progressbar" aria-label="예산 사용률" aria-valuenow="@Math.Min(BudgetPercentage, 100).ToString("0.#", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                    <div class="budget-fill @(budgetSpent > limit ? "over-budget" : "")" style="width: @BudgetBarWidth%"></div>
                </div>
                <p class="budget-balance @(budgetSpent > limit ? "over-budget" : "")">
                    @(budgetSpent > limit ? $"예산을 {(budgetSpent - limit):N0}원 초과했어요." : $"예산이 {(limit - budgetSpent):N0}원 남았어요.")
                </p>
            </div>
        }
        else
        {
            <p class="budget-empty">@budgetMonth.ToString("yyyy년 M월") 지출은 @budgetSpent.ToString("N0")원입니다. 예산을 설정하면 사용률과 남은 금액을 볼 수 있어요.</p>
        }
    </section>

    <section class="panel statistics-panel" aria-labelledby="statistics-title">
        <div class="panel-heading statistics-heading">
            <div>
                <p class="section-kicker">SPENDING BREAKDOWN</p>
                <h2 id="statistics-title">카테고리별 지출</h2>
                <p class="statistics-period">@StatisticsPeriodLabel</p>
            </div>
            <strong class="statistics-total">@StatisticsTotal.ToString("N0")원</strong>
        </div>

        @if (categoryStatistics.Count == 0)
        {
            <p class="statistics-empty">@(activeFilter.IsActive ? "조회 조건에 맞는 지출이 없어요." : "이번 달에 기록된 지출이 없어요.")</p>
        }
        else
        {
            <div class="statistics-list">
                @foreach (var statistic in categoryStatistics)
                {
                    <div class="statistic-row">
                        <div class="statistic-header">
                            <div class="statistic-name">
                                <span class="statistic-icon" aria-hidden="true">@CategoryIcon(statistic.Category)</span>
                                <strong>@statistic.Category <small>@(statistic.Count)건</small></strong>
                            </div>
                            <div class="statistic-values">
                                <strong>@statistic.Amount.ToString("N0")원</strong>
                                <span>@statistic.Percentage.ToString("0.#")%</span>
                            </div>
                        </div>
                        <div class="statistic-track" aria-hidden="true">
                            <div class="statistic-fill" style="@statistic.WidthStyle"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <div class="content-grid">
        <section class="panel entry-panel" aria-labelledby="entry-title">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">NEW ENTRY</p>
                    <h2 id="entry-title">새 지출 추가</h2>
                </div>
            </div>

            <form @onsubmit="AddExpenseAsync" @onsubmit:preventDefault>
                <div class="field-grid">
                    <div class="field">
                        <label for="expense-date">날짜</label>
                        <input id="expense-date" type="date" @bind="expenseDate" required />
                    </div>
                    <div class="field">
                        <label for="expense-amount">금액</label>
                        <div class="amount-input">
                            <input id="expense-amount" type="number" min="1" step="1" placeholder="0" @bind="amount" required />
                            <span>원</span>
                        </div>
                    </div>
                </div>

                <div class="field">
                    <label for="expense-category">카테고리</label>
                    <select id="expense-category" @bind="category">
                        @foreach (var option in categories)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="expense-memo">메모 <span class="optional">선택</span></label>
                    <input id="expense-memo" type="text" maxlength="100" placeholder="예: 점심 식사" @bind="memo" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="form-error" role="alert">@errorMessage</p>
                }

                @if (!string.IsNullOrEmpty(saveNotice))
                {
                    <p class="save-notice" role="status">@saveNotice</p>
                }

                <button class="add-button" type="submit">+ 지출 기록하기</button>
            </form>
        </section>

        <section class="panel history-panel" aria-labelledby="history-title">
            <div class="panel-heading history-heading">
                <div>
                    <p class="section-kicker">HISTORY</p>
                    <h2 id="history-title">지출 내역</h2>
                </div>
                <div class="history-actions">
                    <span class="count-badge">@(expenses.Count)건</span>
                    @if (expenses.Count > 0 && !activeFilter.IsActive && editingId is null)
                    {
                        <button type="button" class="delete-all-trigger" @onclick="ShowDeleteAllConfirmation">전체 삭제</button>
                    }
                </div>
            </div>

            <form class="filter-form" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
                <div class="filter-field">
                    <label for="filter-month">월</label>
                    <input id="filter-month" type="month" value="@filterMonthInput" @onchange="OnFilterMonthChanged" />
                </div>
                <div class="filter-field">
                    <label for="filter-category">카테고리</label>
                    <select id="filter-category" @bind="filterCategoryInput">
                        <option value="">전체 카테고리</option>
                        @foreach (var option in categories)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div class="filter-buttons">
                    <button type="submit" class="filter-apply">조회</button>
                    <button type="button" class="filter-reset" @onclick="ResetFiltersAsync">초기화</button>
                </div>
            </form>

            <div class="export-actions" aria-label="CSV 내보내기">
                <a class="export-link" href="@FilteredExportUrl">현재 조회 결과 CSV</a>
                <a class="export-link" href="/export/expenses.csv?scope=all">전체 기록 CSV</a>
                <a class="export-link" href="/import">CSV 가져오기</a>
            </div>

            @if (!string.IsNullOrEmpty(filterError))
            {
                <p class="form-error" role="alert">@filterError</p>
            }

            @if (activeFilter.IsActive)
            {
                <p class="filter-hint">전체 삭제는 필터를 초기화한 후 사용할 수 있습니다.</p>
            }

            @if (showDeleteAllConfirmation && expenses.Count > 0 && !activeFilter.IsActive)
            {
                <div class="delete-confirm" role="alert">
                    <strong>모든 지출 기록을 삭제할까요?</strong>
                    <p>저장된 @(expenses.Count)건을 모두 삭제합니다. 이 작업은 되돌릴 수 없습니다.</p>
                    <div class="confirm-actions">
                        <button type="button" class="cancel-button" @onclick="CancelDeleteAll" disabled="@isDeletingAll">취소</button>
                        <button type="button" class="confirm-delete-button" @onclick="DeleteAllExpensesAsync" disabled="@isDeletingAll">@(isDeletingAll ? "삭제 중..." : "모두 삭제")</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(deleteError))
            {
                <p class="form-error" role="alert">@deleteError</p>
            }

            @if (!string.IsNullOrEmpty(historyNotice))
            {
                <p class="history-notice" role="status">@historyNotice</p>
            }

            @if (expenses.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon" aria-hidden="true">↗</div>
                    <h3>@(activeFilter.IsActive ? "조건에 맞는 기록이 없어요" : "아직 기록이 없어요")</h3>
                    <p>@(activeFilter.IsActive ? "다른 월이나 카테고리를 선택해 보세요." : "첫 지출을 입력하면 이곳에 내역이 표시됩니다.")</p>
                </div>
            }
            else
            {
                <div class="expense-list">
                    @foreach (var expense in expenses.OrderByDescending(item => item.Date).ThenByDescending(item => item.Id))
                    {
                        <div class="expense-item" @key="expense.Id">
                            <div class="expense-row">
                                <div class="category-icon" aria-hidden="true">@CategoryIcon(expense.Category)</div>
                                <div class="expense-details">
                                    <strong>@expense.Category</strong>
                                    <span>@expense.Date.ToString("yyyy.MM.dd") · @(string.IsNullOrWhiteSpace(expense.Memo) ? "메모 없음" : expense.Memo)</span>
                                </div>
                                <div class="expense-actions">
                                    <strong>-@expense.Amount.ToString("N0")원</strong>
                                    <div class="row-actions">
                                        <button type="button" class="edit-button" @onclick="() => StartEdit(expense)" disabled="@isSavingEdit" aria-label="@expense.Category 지출 수정">수정</button>
                                        <button type="button" class="delete-button" @onclick="() => DeleteExpenseAsync(expense.Id)" disabled="@isSavingEdit" aria-label="@expense.Category 지출 삭제">삭제</button>
                                    </div>
                                </div>
                            </div>

                            @if (editingId == expense.Id)
                            {
                                <form class="edit-form" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                    <h3>지출 수정</h3>
                                    <div class="field-grid">
                                        <div class="field">
                                            <label for="edit-date">날짜</label>
                                            <input id="edit-date" type="date" @bind="editDate" required />
                                        </div>
                                        <div class="field">
                                            <label for="edit-amount">금액</label>
                                            <div class="amount-input">
                                                <input id="edit-amount" type="number" min="1" step="1" @bind="editAmount" required />
                                                <span>원</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="field-grid">
                                        <div class="field">
                                            <label for="edit-category">카테고리</label>
                                            <select id="edit-category" @bind="editCategory">
                                                @foreach (var option in categories)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="edit-memo">메모 <span class="optional">선택</span></label>
                                            <input id="edit-memo" type="text" maxlength="100" @bind="editMemo" />
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(editError))
                                    {
                                        <p class="form-error" role="alert">@editError</p>
                                    }

                                    <div class="edit-form-actions">
                                        <button type="button" class="edit-cancel" @onclick="CancelEdit" disabled="@isSavingEdit">취소</button>
                                        <button type="submit" class="edit-save" disabled="@isSavingEdit">@(isSavingEdit ? "저장 중..." : "변경 저장")</button>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private readonly string[] categories = ["식비", "카페", "교통", "쇼핑", "생활", "기타"];
    private string ownerId = string.Empty;
    private List<ExpenseRecord> expenses = [];
    private IReadOnlyList<CategoryStatistic> categoryStatistics = [];
    private DateTime expenseDate = DateTime.Today;
    private long amount;
    private string category = "식비";
    private string memo = string.Empty;
    private string? errorMessage;
    private string? saveNotice;
    private string? deleteError;
    private string? historyNotice;
    private string? filterError;
    private string filterMonthInput = string.Empty;
    private string filterCategoryInput = string.Empty;
    private ExpenseFilter activeFilter = new();
    private DateTime budgetMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string budgetMonthInput = DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private long budgetInput;
    private long? budgetAmount;
    private long budgetSpent;
    private string? budgetError;
    private string? budgetNotice;
    private bool isSavingBudget;
    private bool showDeleteAllConfirmation;
    private bool isDeletingAll;
    private int? editingId;
    private DateTime editDate = DateTime.Today;
    private long editAmount;
    private string editCategory = "식비";
    private string editMemo = string.Empty;
    private string? editError;
    private bool isSavingEdit;
    private long FilteredTotal => expenses.Sum(item => item.Amount);
    private long MonthlyTotal => expenses
        .Where(item => item.Date.Year == DateTime.Today.Year && item.Date.Month == DateTime.Today.Month)
        .Sum(item => item.Amount);
    private long StatisticsTotal => categoryStatistics.Sum(statistic => statistic.Amount);
    private decimal BudgetPercentage => budgetAmount is > 0 ? (decimal)budgetSpent / budgetAmount.Value * 100 : 0;
    private string BudgetBarWidth => Math.Min(BudgetPercentage, 100).ToString("0.#", CultureInfo.InvariantCulture);
    private string StatisticsPeriodLabel => activeFilter.IsActive
        ? FilterDescription
        : $"{DateTime.Today:yyyy년 M월} 기준";
    private string FilterDescription
    {
        get
        {
            var period = activeFilter.Month is DateTime month ? month.ToString("yyyy년 M월") : "전체 기간";
            return activeFilter.Category is string category ? $"{period} · {category}" : period;
        }
    }
    private string FilteredExportUrl
    {
        get
        {
            var url = "/export/expenses.csv?scope=filtered";
            if (activeFilter.Month is DateTime month)
                url += $"&month={month.ToString("yyyy-MM", CultureInfo.InvariantCulture)}";
            if (activeFilter.Category is string category)
                url += $"&category={Uri.EscapeDataString(category)}";
            return url;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ownerId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        if (string.IsNullOrEmpty(ownerId))
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }

        if (await UserDataProvisioner.EnsureUserAsync(ownerId))
        {
            Navigation.NavigateTo("/welcome");
            return;
        }

        try
        {
            await LoadExpensesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "지출 내역을 불러오지 못했습니다.");
            errorMessage = "저장된 지출 내역을 불러오지 못했습니다. 앱을 다시 실행해 주세요.";
        }

        await RefreshBudgetAsync();
    }

    private async Task LoadExpensesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var ownedExpenses = db.Expenses.AsNoTracking()
            .Where(item => item.OwnerId == ownerId);
        expenses = await activeFilter.ApplyTo(ownedExpenses)
            .OrderByDescending(item => item.Date)
            .ThenByDescending(item => item.Id)
            .ToListAsync();
        var statisticsExpenses = activeFilter.IsActive
            ? expenses
            : expenses.Where(item => item.Date.Year == DateTime.Today.Year && item.Date.Month == DateTime.Today.Month);
        categoryStatistics = ExpenseStatistics.ByCategory(statisticsExpenses);
    }

    private async Task LoadBudgetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var ownedExpenses = db.Expenses.AsNoTracking()
            .Where(item => item.OwnerId == ownerId);
        var amounts = await new ExpenseFilter(budgetMonth).ApplyTo(ownedExpenses)
            .Select(item => item.Amount)
            .ToListAsync();
        budgetSpent = amounts.Sum();
        budgetAmount = await db.MonthlyBudgets.AsNoTracking()
            .Where(item => item.OwnerId == ownerId && item.Month == budgetMonth)
            .Select(item => (long?)item.Amount)
            .SingleOrDefaultAsync();
        budgetInput = budgetAmount ?? 0;
    }

    private async Task RefreshBudgetAsync()
    {
        try
        {
            await LoadBudgetAsync();
            budgetError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "월별 예산을 불러오지 못했습니다.");
            budgetError = "예산을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.";
        }
    }

    private async Task OnBudgetMonthChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        if (!DateTime.TryParseExact(value, "yyyy-MM", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var parsedMonth))
        {
            budgetError = "예산을 조회할 월을 다시 선택해 주세요.";
            return;
        }

        budgetMonth = new DateTime(parsedMonth.Year, parsedMonth.Month, 1);
        budgetMonthInput = value;
        budgetNotice = null;
        await RefreshBudgetAsync();
    }

    private async Task SaveBudgetAsync()
    {
        if (isSavingBudget)
            return;
        if (budgetInput <= 0)
        {
            budgetError = "예산은 1원 이상의 정수로 입력해 주세요.";
            return;
        }

        isSavingBudget = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var saved = await db.MonthlyBudgets.FindAsync(ownerId, budgetMonth);
            if (saved is null)
                db.MonthlyBudgets.Add(new MonthlyBudget
                {
                    OwnerId = ownerId,
                    Month = budgetMonth,
                    Amount = budgetInput
                });
            else
                saved.Amount = budgetInput;
            await db.SaveChangesAsync();
            await LoadBudgetAsync();
            budgetError = null;
            budgetNotice = "예산을 저장했습니다.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "월별 예산을 저장하지 못했습니다.");
            budgetError = "예산 저장 결과를 확인하지 못했습니다. 새로고침 후 다시 확인해 주세요.";
        }
        finally
        {
            isSavingBudget = false;
        }
    }

    private async Task DeleteBudgetAsync()
    {
        if (isSavingBudget || budgetAmount is null)
            return;

        isSavingBudget = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var saved = await db.MonthlyBudgets.FindAsync(ownerId, budgetMonth);
            if (saved is not null)
            {
                db.MonthlyBudgets.Remove(saved);
                await db.SaveChangesAsync();
            }
            await LoadBudgetAsync();
            budgetError = null;
            budgetNotice = "예산을 삭제했습니다. 지출 기록은 그대로 유지됩니다.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "월별 예산을 삭제하지 못했습니다.");
            budgetError = "예산 삭제 결과를 확인하지 못했습니다. 새로고침 후 다시 확인해 주세요.";
        }
        finally
        {
            isSavingBudget = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        DateTime? month = null;
        if (!string.IsNullOrWhiteSpace(filterMonthInput))
        {
            if (!DateTime.TryParseExact(filterMonthInput, "yyyy-MM", CultureInfo.InvariantCulture,
                    DateTimeStyles.None, out var parsedMonth))
            {
                filterError = "조회할 월을 다시 선택해 주세요.";
                return;
            }

            month = new DateTime(parsedMonth.Year, parsedMonth.Month, 1);
        }

        if (!string.IsNullOrEmpty(filterCategoryInput) && !categories.Contains(filterCategoryInput))
        {
            filterError = "조회할 카테고리를 다시 선택해 주세요.";
            return;
        }

        var previousFilter = activeFilter;
        activeFilter = new ExpenseFilter(month,
            string.IsNullOrEmpty(filterCategoryInput) ? null : filterCategoryInput);

        try
        {
            await LoadExpensesAsync();
            filterError = null;
            deleteError = null;
            saveNotice = null;
            historyNotice = null;
            showDeleteAllConfirmation = false;
            CancelEdit();
        }
        catch (Exception ex)
        {
            activeFilter = previousFilter;
            Logger.LogError(ex, "지출 내역 필터 조회에 실패했습니다.");
            filterError = "지출 내역을 조회하지 못했습니다. 잠시 후 다시 시도해 주세요.";
        }
    }

    private async Task ResetFiltersAsync()
    {
        filterMonthInput = string.Empty;
        filterCategoryInput = string.Empty;
        await ApplyFiltersAsync();
    }

    private void OnFilterMonthChanged(ChangeEventArgs args)
    {
        filterMonthInput = args.Value?.ToString() ?? string.Empty;
    }

    private async Task AddExpenseAsync()
    {
        if (amount <= 0)
        {
            errorMessage = "금액은 1원 이상의 정수로 입력해 주세요.";
            return;
        }

        if (!categories.Contains(category))
        {
            errorMessage = "카테고리를 선택해 주세요.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var newExpense = new ExpenseRecord
            {
                OwnerId = ownerId,
                Date = expenseDate.Date,
                Amount = amount,
                Category = category,
                Memo = memo.Trim()
            };
            db.Expenses.Add(newExpense);
            await db.SaveChangesAsync();
            await LoadExpensesAsync();
            await RefreshBudgetAsync();

            amount = 0;
            memo = string.Empty;
            errorMessage = null;
            saveNotice = activeFilter.IsActive && !activeFilter.Matches(newExpense)
                ? "저장했습니다. 현재 조회 조건에 맞지 않아 목록에는 표시되지 않습니다."
                : null;
            showDeleteAllConfirmation = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "지출 내역을 저장하지 못했습니다.");
            errorMessage = "지출 내역을 저장하지 못했습니다. 잠시 후 다시 시도해 주세요.";
        }
    }

    private void StartEdit(ExpenseRecord expense)
    {
        if (isSavingEdit)
            return;

        editingId = expense.Id;
        editDate = expense.Date;
        editAmount = expense.Amount;
        editCategory = expense.Category;
        editMemo = expense.Memo;
        editError = null;
        historyNotice = null;
        deleteError = null;
        showDeleteAllConfirmation = false;
    }

    private void CancelEdit()
    {
        editingId = null;
        editError = null;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not int id || isSavingEdit)
            return;

        if (editDate == default || editAmount <= 0)
        {
            editError = "날짜와 1원 이상의 금액을 입력해 주세요.";
            return;
        }

        if (!categories.Contains(editCategory) || editMemo.Length > 100)
        {
            editError = "카테고리와 메모를 다시 확인해 주세요.";
            return;
        }

        isSavingEdit = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var expense = await db.Expenses
                .SingleOrDefaultAsync(item => item.Id == id && item.OwnerId == ownerId);
            if (expense is null)
            {
                await LoadExpensesAsync();
                CancelEdit();
                historyNotice = "수정할 기록을 찾을 수 없어 목록을 새로고침했습니다.";
                return;
            }

            expense.Date = editDate.Date;
            expense.Amount = editAmount;
            expense.Category = editCategory;
            expense.Memo = editMemo.Trim();
            await db.SaveChangesAsync();
            await LoadExpensesAsync();
            await RefreshBudgetAsync();

            historyNotice = activeFilter.IsActive && !activeFilter.Matches(expense)
                ? "수정했습니다. 변경된 기록은 현재 조회 조건에 맞지 않아 목록에서 보이지 않습니다."
                : "지출 기록을 수정했습니다.";
            CancelEdit();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "지출 내역을 수정하지 못했습니다.");
            editError = "수정 결과를 확인하지 못했습니다. 새로고침 후 다시 확인해 주세요.";
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task DeleteExpenseAsync(int id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var expense = await db.Expenses
                .SingleOrDefaultAsync(item => item.Id == id && item.OwnerId == ownerId);
            if (expense is null)
            {
                await LoadExpensesAsync();
                return;
            }

            db.Expenses.Remove(expense);
            await db.SaveChangesAsync();
            await LoadExpensesAsync();
            await RefreshBudgetAsync();
            deleteError = null;
            historyNotice = null;
            showDeleteAllConfirmation = false;
            if (editingId == id)
                CancelEdit();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "지출 내역을 삭제하지 못했습니다.");
            deleteError = "지출 내역을 삭제하지 못했습니다. 잠시 후 다시 시도해 주세요.";
        }
    }

    private void ShowDeleteAllConfirmation()
    {
        if (activeFilter.IsActive || expenses.Count == 0 || editingId is not null)
            return;

        deleteError = null;
        showDeleteAllConfirmation = true;
    }

    private void CancelDeleteAll()
    {
        showDeleteAllConfirmation = false;
    }

    private async Task DeleteAllExpensesAsync()
    {
        if (!showDeleteAllConfirmation || isDeletingAll || activeFilter.IsActive || editingId is not null || expenses.Count == 0)
            return;

        isDeletingAll = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Expenses
                .Where(item => item.OwnerId == ownerId)
                .ExecuteDeleteAsync();
            await LoadExpensesAsync();
            await RefreshBudgetAsync();
            showDeleteAllConfirmation = false;
            deleteError = null;
            historyNotice = null;
            CancelEdit();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "전체 지출 내역을 삭제하지 못했습니다.");
            deleteError = "전체 삭제에 실패했습니다. 잠시 후 다시 시도해 주세요.";
        }
        finally
        {
            isDeletingAll = false;
        }
    }

    private static string CategoryIcon(string value) => value switch
    {
        "식비" => "🍽",
        "카페" => "☕",
        "교통" => "🚆",
        "쇼핑" => "🛍",
        "생활" => "🏠",
        _ => "▦"
    };
}
