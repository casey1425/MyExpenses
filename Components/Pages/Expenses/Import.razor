@page "/import"
@namespace MyExpenses.Components.Pages
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using MyExpenses.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ExpenseCsvImportService ImportService
@inject CategoryService CategoryService
@inject ILogger<Import> Logger

<PageTitle>CSV 가져오기 | MyExpenses</PageTitle>

<main class="import-page">
    <PageHeader Title="CSV 가져오기" Description="MyExpenses에서 내보낸 CSV 파일을 현재 로그인한 계정에 가져옵니다." />

    <section class="import-card" aria-labelledby="upload-title">
        <h2 id="upload-title">파일 선택</h2>
        <p>최대 1MB, 지출 1,000건까지 지원합니다. 파일을 선택해도 바로 저장되지는 않습니다.</p>
        <InputFile @key="fileInputVersion" OnChange="ReadFileAsync" accept=".csv,text/csv"
                   disabled="@(isReading || isSaving)" aria-label="지출 CSV 파일 선택" />
        <p class="format-hint">카테고리는 내 계정에 사용 중인 이름으로 먼저 등록해 주세요. 보관한 카테고리는 복원 후 가져올 수 있습니다.</p>
        <p class="format-hint">첫 줄: <code>날짜,금액(원),카테고리,메모,결제수단,결제유형,태그</code> (4열·6열 파일도 지원). 태그는 <code>여행;경조사</code>처럼 세미콜론으로 구분하며 최대 5개입니다.</p>
        <p class="format-hint">CSV의 결제수단 이름·유형을 <a href="/payment-methods">내 결제수단</a>에 먼저 등록해 주세요. 두 열이 비어 있으면 미지정입니다.</p>
        <p class="format-hint">CSV 가져오기는 지출만 복원합니다. 월별 예산은 포함되지 않습니다.</p>
    </section>

    @if (isReading)
    {
        <p class="import-status" role="status">파일을 확인하고 있습니다...</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="import-error" role="alert">@errorMessage</p>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="import-success" role="status">
            <p>@successMessage</p>
            <a href="/">지출 기록 보기</a>
        </div>
    }

    @if (parseResult is not null)
    {
        <section class="import-card" aria-labelledby="preview-title">
            <h2 id="preview-title">가져오기 미리보기</h2>
            <p class="import-counts">
                유효한 지출 @(candidates.Count)건 · 중복 후보 @(DuplicateCount)건 · 오류 @(parseResult.Issues.Count)건
            </p>

            @if (parseResult.Issues.Count > 0)
            {
                <div class="import-issues" role="alert">
                    <strong>오류를 수정한 뒤 파일을 다시 선택해 주세요. 오류가 있으면 저장할 수 없습니다.</strong>
                    <ul>
                        @foreach (var issue in parseResult.Issues.Take(10))
                        {
                            <li>@(issue.RowNumber)번째 행: @issue.Message</li>
                        }
                    </ul>
                    @if (parseResult.Issues.Count > 10)
                    {
                        <p>그 밖에 @(parseResult.Issues.Count - 10)건의 오류가 있습니다.</p>
                    }
                </div>
            }

            @if (candidates.Count > 0)
            {
                <div class="import-table-wrap">
                    <table class="import-table">
                        <thead>
                            <tr><th>행</th><th>날짜</th><th>금액</th><th>카테고리</th><th>메모</th><th>결제수단</th><th>태그</th><th>상태</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in candidates.Take(20))
                            {
                                <tr>
                                    <td>@candidate.Row.RowNumber</td>
                                    <td>@candidate.Row.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@candidate.Row.Amount.ToString("N0")원</td>
                                    <td>@candidate.Row.Category</td>
                                    <td class="import-memo">@candidate.Row.Memo</td>
                                    <td>@(candidate.Row.PaymentMethodName == "" ? "미지정" : $"{candidate.Row.PaymentMethodName} ({candidate.Row.PaymentMethodType})")</td>
                                    <td>@(candidate.Row.Tags is { Count: > 0 } rowTags ? string.Join(" ", rowTags.Select(tag => "#" + tag)) : "-")</td>
                                    <td>@(candidate.IsDuplicate ? "중복 후보" : "새 기록")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (candidates.Count > 20)
                {
                    <p class="format-hint">처음 20건만 표시합니다. 나머지 @(candidates.Count - 20)건도 저장 대상에 포함됩니다.</p>
                }

                @if (DuplicateCount > 0)
                {
                    <label class="duplicate-option">
                        <input type="checkbox" @bind="includeDuplicates" />
                        중복 후보도 가져오기
                    </label>
                    <p class="format-hint">날짜·금액·카테고리·메모·결제수단이 모두 같으면 중복 후보입니다. 실제로 별개인 지출도 해당될 수 있습니다.</p>
                }

                <div class="import-actions">
                    <button type="button" @onclick="SaveAsync"
                            disabled="@(isSaving || isReading || parseResult.Issues.Count > 0 || (!includeDuplicates && candidates.Count == DuplicateCount))">
                        @(isSaving ? "저장 중..." : includeDuplicates ? $"{candidates.Count:N0}건 가져오기" : $"{candidates.Count - DuplicateCount:N0}건 가져오기")
                    </button>
                </div>
            }
        </section>
    }
</main>
