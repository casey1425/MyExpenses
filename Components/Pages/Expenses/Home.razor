@page "/"
@namespace MyExpenses.Components.Pages
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using MyExpenses.Data
@using MyExpenses.Components.Expenses
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserDataProvisioner UserDataProvisioner
@inject RecurringExpenseService RecurringExpenseService
@inject RecurringIncomeService RecurringIncomeService
@inject ExpenseTemplateService TemplateService
@inject PaymentMethodService MethodService
@inject ExpenseService ExpenseService
@inject BudgetService BudgetService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>지출 기록 | MyExpenses</PageTitle>

<div class="expense-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">MY EXPENSES</p>
            <h1>지출 기록</h1>
            <p class="subtitle">오늘의 지출을 간편하게 기록하고 확인해 보세요.</p>
            <a href="/recurring">정기 지출 관리 →</a>
            <span aria-hidden="true"> · </span>
            <a href="/trends">월별 수입·지출 추이 →</a>
        </div>
        <div class="today-chip">@KoreanClock.Today.ToString("yyyy년 M월 d일")</div>
    </header>

    <section class="summary-grid" aria-label="지출 요약">
        <div class="summary-card primary-summary">
            <span class="summary-label">@(activeFilter.IsActive ? "필터 결과 합계" : "이번 달 지출")</span>
            <strong>@((activeFilter.IsActive ? FilteredTotal : MonthlyTotal).ToString("N0"))<small>원</small></strong>
            <span class="summary-note">@(activeFilter.IsActive ? FilterDescription : $"{KoreanClock.Today:yyyy년 M월} 기준")</span>
        </div>
        <div class="summary-card">
            <span class="summary-label">@(activeFilter.IsActive ? "조회된 지출" : "기록한 지출")</span>
            <strong>@expenses.Count<small>건</small></strong>
            <span class="summary-note">@(activeFilter.IsActive ? FilterDescription : "전체 기록")</span>
        </div>
    </section>

    <BudgetPanel Month="budgetMonth" MonthInput="@budgetMonthInput" OnMonthChanged="OnBudgetMonthChangedAsync"
                 Disabled="@(savingCategoryBudget is not null || isSavingBudget)"
                 @bind-Input="budgetInput" IsSaving="isSavingBudget" Amount="budgetAmount" Spent="budgetSpent"
                 Error="@budgetError" Notice="@budgetNotice" OnSave="SaveBudgetAsync" OnDelete="DeleteBudgetAsync" />

    <CategoryBudgetPanel Month="budgetMonth" Error="@categoryBudgetError" Notice="@categoryBudgetNotice"
                         Categories="allCategories" Label="CategoryLabel" Spent="categoryBudgetSpent"
                         Amounts="categoryBudgetAmounts" Inputs="categoryBudgetInputs" Saving="@savingCategoryBudget"
                         OnSave="SaveCategoryBudgetAsync" OnDelete="DeleteCategoryBudgetAsync" />

    <CategoryStatsPanel Statistics="categoryStatistics" PeriodLabel="@StatisticsPeriodLabel" Total="StatisticsTotal"
                        FilterActive="activeFilter.IsActive" />

    <div class="content-grid">
        <ExpenseForm Templates="templates" SelectedTemplateId="@selectedTemplateId" TemplateBusy="templateBusy"
                     TemplateError="@templateError" TemplateNotice="@templateNotice"
                     OnTemplateSelected="ApplyTemplateAsync" OnRefreshTemplates="RefreshTemplatesAsync"
                     @bind-Date="expenseDate" @bind-Amount="amount" @bind-Category="category" @bind-Memo="memo"
                     @bind-PaymentMethodId="paymentMethodId" Categories="categories" CategoryLabel="CategoryLabel"
                     PaymentMethods="paymentMethods" PaymentBusy="paymentBusy" PaymentError="@paymentError"
                     OnRefreshPaymentMethods="RefreshPaymentMethodsAsync" ErrorMessage="@errorMessage"
                     SaveNotice="@saveNotice" OnSubmit="AddExpenseAsync" />

        <section class="panel history-panel" aria-labelledby="history-title">
            <div class="panel-heading history-heading">
                <div>
                    <p class="section-kicker">HISTORY</p>
                    <h2 id="history-title">지출 내역</h2>
                </div>
                <div class="history-actions">
                    <span class="count-badge">@(expenses.Count)건</span>
                    @if (expenses.Count > 0 && !activeFilter.IsActive && editingId is null)
                    {
                        <button type="button" class="delete-all-trigger" @onclick="ShowDeleteAllConfirmation">전체 삭제</button>
                    }
                </div>
            </div>

            <ExpenseFilterForm Input="searchInput" Categories="allCategories" CategoryLabel="CategoryLabel"
                               PaymentMethods="paymentMethods" IsSearching="isSearching"
                               OnApply="ApplyFiltersAsync" OnReset="ResetFiltersAsync" />

            <p class="filter-result" role="status">@FilterDescription · @expenses.Count 건 · 합계 @FilteredTotal.ToString("N0")원</p>

            <div class="export-actions" aria-label="CSV 내보내기">
                <a class="export-link" href="@FilteredExportUrl">현재 조회 결과 CSV</a>
                <a class="export-link" href="/export/expenses.csv?scope=all">전체 기록 CSV</a>
                <a class="export-link" href="/import">CSV 가져오기</a>
            </div>

            @if (!string.IsNullOrEmpty(filterError))
            {
                <p class="form-error" role="alert">@filterError</p>
            }

            @if (activeFilter.IsActive)
            {
                <p class="filter-hint">전체 삭제는 필터를 초기화한 후 사용할 수 있습니다.</p>
            }

            @if (showDeleteAllConfirmation && expenses.Count > 0 && !activeFilter.IsActive)
            {
                <div class="delete-confirm" role="alert">
                    <strong>모든 지출 기록을 삭제할까요?</strong>
                    <p>저장된 @(expenses.Count)건을 모두 삭제합니다. 이 작업은 되돌릴 수 없습니다.</p>
                    <div class="confirm-actions">
                        <button type="button" class="cancel-button" @onclick="CancelDeleteAll" disabled="@isDeletingAll">취소</button>
                        <button type="button" class="confirm-delete-button" @onclick="DeleteAllExpensesAsync" disabled="@isDeletingAll">@(isDeletingAll ? "삭제 중..." : "모두 삭제")</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(deleteError))
            {
                <p class="form-error" role="alert">@deleteError</p>
            }

            @if (!string.IsNullOrEmpty(historyNotice))
            {
                <p class="history-notice" role="status">@historyNotice</p>
            }

            <ExpenseList Expenses="expenses" FilterActive="activeFilter.IsActive" EditingId="editingId"
                         IsSavingEdit="isSavingEdit" EditError="@editError" EditCategories="EditCategories"
                         CategoryLabel="CategoryLabel" PaymentMethods="paymentMethods"
                         @bind-EditDate="editDate" @bind-EditAmount="editAmount" @bind-EditCategory="editCategory"
                         @bind-EditMemo="editMemo" @bind-EditPaymentMethodId="editPaymentMethodId"
                         OnStartEdit="StartEdit" OnDelete="DeleteExpenseAsync" OnSaveEdit="SaveEditAsync"
                         OnCancelEdit="CancelEdit" />
        </section>
    </div>
</div>
