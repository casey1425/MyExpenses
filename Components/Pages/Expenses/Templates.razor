@page "/templates"
@namespace MyExpenses.Components.Pages
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using MyExpenses.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ExpenseTemplateService TemplateService
@inject PaymentMethodService MethodService
@inject CategoryService CategoryService
@inject ILogger<Templates> Logger

<PageTitle>즐겨찾기 지출 | MyExpenses</PageTitle>

<main class="templates-page">
    <PageHeader Title="즐겨찾기 지출 템플릿" Description="커피·점심처럼 자주 입력하는 지출을 저장해 두세요. 자동으로 지출을 생성하지는 않습니다." />

    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }

    <section class="template-card" aria-labelledby="template-form-title">
        <h2 id="template-form-title">@(editingId is null ? "새 템플릿" : "템플릿 수정")</h2>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <div class="template-fields">
                    <label>이름 <input type="text" maxlength="50" placeholder="예: 아메리카노" @bind="input.Name" required /></label>
                    <label>금액 (원) <input type="number" min="1" step="1" @bind="input.Amount" required /></label>
                    <label>카테고리
                        <select @bind="input.Category">
                            @foreach (var category in categoryNames.Concat(editingId.HasValue ? new[] { input.Category } : Array.Empty<string>()).Distinct()) { <option value="@category">@category</option> }
                        </select>
                    </label>
                    <label>메모 (선택) <input type="text" maxlength="100" @bind="input.Memo" /></label>
                    <label>기본 결제수단
                        <select @bind="input.PaymentMethodId">
                            <option value="">미지정</option>
                            @foreach (var method in methods) { <option value="@method.Id">@method.Name (@method.Type)</option> }
                        </select>
                    </label>
                </div>
                <div class="actions">
                    <button type="submit">@(busy ? "처리 중..." : editingId is null ? "템플릿 저장" : "수정 저장")</button>
                    @if (editingId is not null) { <button type="button" class="secondary" @onclick="CancelEdit">취소</button> }
                </div>
            </fieldset>
        </form>
        <p class="help"><a href="/payment-methods">결제수단 관리</a>에서 등록한 뒤 목록을 새로고침해 주세요.</p>
    </section>

    <section class="template-card" aria-labelledby="template-list-title">
        <div class="list-heading">
            <h2 id="template-list-title">내 템플릿 (@templates.Count)</h2>
            <button type="button" class="secondary" disabled="@busy" @onclick="RefreshAsync">새로고침</button>
        </div>
        @if (loading) { <p>불러오는 중...</p> }
        else if (templates.Count == 0) { <p class="help">아직 저장한 템플릿이 없어요. 위에서 첫 템플릿을 만들어 보세요.</p> }
        else
        {
            @foreach (var template in templates)
            {
                <article class="template-item" @key="template.Id">
                    <div class="template-summary">
                        <div>
                            <h3>@template.Name</h3>
                            <p>@template.Amount.ToString("N0")원 · @template.Category</p>
                            <p class="help">결제수단: @(template.PaymentMethod?.Name ?? "미지정")</p>
                            @if (template.Memo != "") { <p class="help">@template.Memo</p> }
                        </div>
                        <div class="actions">
                            <button type="button" class="secondary" disabled="@busy" @onclick="() => Edit(template)">수정</button>
                            <button type="button" class="danger" disabled="@busy" @onclick="() => ConfirmDelete(template.Id)">삭제</button>
                        </div>
                    </div>
                    @if (deletingId == template.Id)
                    {
                        <div class="delete-confirm" role="alert">
                            <p>이 템플릿을 삭제할까요? 이미 기록한 지출은 유지됩니다.</p>
                            <div class="actions">
                                <button type="button" class="danger" disabled="@busy" @onclick="() => DeleteAsync(template.Id)">템플릿 삭제</button>
                                <button type="button" class="secondary" disabled="@busy" @onclick="() => deletingId = null">취소</button>
                            </div>
                        </div>
                    }
                </article>
            }
        }
    </section>
</main>
