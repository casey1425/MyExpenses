@page "/account/register"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager

<PageTitle>관리자 계정 만들기 | MyExpenses</PageTitle>

<div class="account-page">
    <section class="account-card" aria-labelledby="register-title">
        <p class="account-kicker">FIRST SETUP</p>
        <h1 id="register-title">관리자 계정 만들기</h1>

        @if (hasAccount)
        {
            <p class="account-description">관리자 계정이 이미 만들어져 있습니다.</p>
            <p class="account-link"><a href="/account/login">로그인 화면으로 이동</a></p>
        }
        else
        {
            <p class="account-description">이 앱을 사용할 첫 계정을 만듭니다. 이후에는 추가 가입을 받지 않습니다.</p>

            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="account-error" role="alert">@Error</p>
            }

            <form method="post" action="/account/register" class="account-form">
                <AntiforgeryToken />
                <label for="register-email">이메일</label>
                <input id="register-email" name="Email" type="email" autocomplete="username" required autofocus />

                <label for="register-password">비밀번호</label>
                <input id="register-password" name="Password" type="password" autocomplete="new-password" minlength="10" required />
                <small>10자 이상이며 영문 대문자·소문자와 숫자를 포함해야 합니다.</small>

                <label for="register-confirm">비밀번호 확인</label>
                <input id="register-confirm" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required />

                <button type="submit">계정 만들기</button>
            </form>
        }
    </section>
</div>

@code {
    private bool hasAccount;

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        hasAccount = await UserManager.Users.AnyAsync();
    }
}
