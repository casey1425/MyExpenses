@page "/account/deleted"
@attribute [AllowAnonymous]

<PageTitle>계정 삭제 완료 | MyExpenses</PageTitle>

<div class="account-page">
    <section class="account-card" aria-labelledby="deleted-title">
        <p class="account-kicker">MY EXPENSES</p>
        <h1 id="deleted-title">계정이 삭제되었습니다</h1>
        <p class="account-description">계정과 연결된 지출, 예산, 로그인 정보를 삭제했습니다.</p>
        <a class="google-login-button" href="/account/login">로그인 화면으로</a>
    </section>
</div>
