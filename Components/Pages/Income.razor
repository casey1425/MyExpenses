@page "/income"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using MyExpenses.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IncomeService IncomeService
@inject ILogger<Income> Logger

<PageTitle>수입 기록 | MyExpenses</PageTitle>
<main class="income-page">
    <header>
        <p class="kicker">INCOME</p>
        <h1>수입 기록</h1>
        <p>월급·부수입·용돈을 기록하고 같은 달 지출과 비교해 순수지와 저축률을 확인합니다. 금액은 원 단위입니다.</p>
        <a href="/">← 지출 기록으로 돌아가기</a>
    </header>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    <section class="income-card" aria-labelledby="income-form-title">
        <h2 id="income-form-title">@(editingId is null ? "수입 등록" : "수입 수정")</h2>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset disabled="@busy">
                <div class="income-fields">
                    <label>날짜 <input type="date" @bind="date" required /></label>
                    <label>금액(원) <input type="number" min="1" step="1" @bind="amount" required /></label>
                    <label>분류
                        <select @bind="source">
                            @foreach (var option in IncomeRecord.Sources) { <option value="@option">@option</option> }
                        </select>
                    </label>
                    <label>메모 <input type="text" maxlength="100" placeholder="예: 10월 급여" @bind="memo" /></label>
                </div>
                <div class="actions">
                    <button type="submit">@(busy ? "처리 중..." : editingId is null ? "등록" : "변경 저장")</button>
                    @if (editingId is not null) { <button type="button" class="secondary" @onclick="CancelEdit">취소</button> }
                </div>
            </fieldset>
        </form>
    </section>
    <section class="income-card" aria-labelledby="income-list-title">
        <h2 id="income-list-title">월별 수입과 순수지</h2>
        <div class="month-selector">
            <label for="income-month">조회 월</label>
            <input id="income-month" type="month" value="@monthInput" @onchange="MonthChangedAsync" disabled="@busy" />
            <button type="button" class="secondary" @onclick="RefreshAsync" disabled="@busy">새로고침</button>
        </div>
        <div class="csv-links" aria-label="수입 CSV">
            <a href="/export/income.csv?month=@monthInput">선택한 달 CSV</a>
            <a href="/export/income.csv">전체 수입 CSV</a>
            <a href="/income/import">CSV 가져오기</a>
        </div>
        @if (loading) { <p>불러오는 중...</p> }
        else
        {
            <div class="summary" role="status">
                <div><span>수입</span><strong class="plus">@cashflow.Income.ToString("N0")원</strong></div>
                <div><span>지출</span><strong>@cashflow.Expense.ToString("N0")원</strong></div>
                <div><span>순수지</span><strong class="@(cashflow.Net < 0 ? "minus" : "plus")">@(cashflow.Net < 0 ? "-" : "")@Math.Abs(cashflow.Net).ToString("N0")원</strong></div>
                <div><span>저축률</span><strong>@(cashflow.SavingsRate is double rate ? $"{rate.ToString("0.#", CultureInfo.InvariantCulture)}%" : "-")</strong></div>
            </div>
            <p class="help">지출은 선택한 달 전체의 지출 기록 합계입니다. 저축률은 (수입 − 지출) ÷ 수입이며, 수입이 없으면 표시하지 않습니다.</p>
            @if (incomes.Count == 0) { <p class="help">@month.ToString("yyyy년 M월")에 기록된 수입이 없어요. 위에서 등록해 보세요.</p> }
            @foreach (var income in incomes)
            {
                <article class="income-item">
                    <div class="income-row">
                        <div>
                            <h3>@income.Source · @income.Amount.ToString("N0")원</h3>
                            <p>@income.Date.ToString("yyyy-MM-dd")@(income.Memo == "" ? "" : $" · {income.Memo}")</p>
                        </div>
                        <div class="actions">
                            <button type="button" class="secondary" @onclick="() => Edit(income)" disabled="@busy">수정</button>
                            <button type="button" class="danger" @onclick="() => deletingId = income.Id" disabled="@busy">삭제</button>
                        </div>
                    </div>
                    @if (deletingId == income.Id)
                    {
                        <div class="delete-confirm" role="alert">
                            <p>이 수입 기록을 삭제할까요? 삭제하면 되돌릴 수 없습니다.</p>
                            <div class="actions">
                                <button type="button" class="danger" @onclick="() => DeleteAsync(income.Id)" disabled="@busy">수입 삭제</button>
                                <button type="button" class="secondary" @onclick="() => deletingId = null" disabled="@busy">취소</button>
                            </div>
                        </div>
                    }
                </article>
            }
        }
    </section>
</main>
