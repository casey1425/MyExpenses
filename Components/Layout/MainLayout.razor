@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">본문으로 건너뛰기</a>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="어두운 화면으로 전환">
                <span class="theme-icon-to-dark" aria-hidden="true">☾</span><span class="theme-icon-to-light" aria-hidden="true">☀</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <span class="signed-in-user">@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout" class="logout-form">
                        <AntiforgeryToken />
                        <button type="submit">로그아웃</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login">로그인</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4" id="main-content" tabindex="-1">
            @Body
        </article>

        <footer class="site-footer px-4">
            <span>© @KoreanClock.Today.Year MyExpenses</span>
            <a href="/about">서비스 소개</a>
            <a href="/privacy">개인정보 처리방침</a>
            <a href="/terms">이용약관</a>
        </footer>
    </main>
</div>

<AuthorizeView>
    <Authorized>
        <BottomNav />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss">🗙</span>
</div>
