@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="signed-in-user">@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout" class="logout-form">
                        <AntiforgeryToken />
                        <button type="submit">로그아웃</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login">로그인</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss">🗙</span>
</div>
